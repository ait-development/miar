# Yandex Cloud Configuration
# Получить значения: yc config list

# Cloud ID
YC_CLOUD_ID=b1g...

# Folder ID
YC_FOLDER_ID=b1g...

# Container Registry ID
# Получить: yc container registry list
YC_REGISTRY_ID=crp...

# Service Account ID
# Получить: yc iam service-account get github-deployer --format json | jq -r '.id'
YC_SERVICE_ACCOUNT_ID=aje...

# RabbitMQ Configuration
# Для локальной разработки
RABBITMQ_URL=amqp://admin:admin@localhost:5672/

# Для production (замените на ваши данные)
# RABBITMQ_URL=amqp://username:password@your-rabbitmq-host:5672/

# Service Configuration (для локальной разработки)
SERVICE_NAME=audit-service
SERVICE_ROLE=audit
SERVICE_PORT=8000
SLEEP_SYMBOL=-

# Python Environment
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

